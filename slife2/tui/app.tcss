/* The transcript fills the screen; the prompt and the status row sit under it.
   Design ported from slife v1 — a dark, low-chrome look with warm amber
   accents.  Colours come from `theme.py` through the custom CSS variables the
   app publishes, so no hex appears in this file or in the widgets. */

Screen {
    layout: vertical;
    background: $slife-bg;
    color: $slife-text;
}

/* ── The transcript ─────────────────────────────────────────────────────── */

/* The scrollbar is hidden, on the grounds that a scrollbar in a chat window is
   noise: the content is a conversation, and where you are in it is answered by
   what you can read.  Scrolling still works, by wheel and by PageUp/PageDown. */
ChatView {
    height: 1fr;
    padding: 0;
    overflow-y: auto;
    scrollbar-size: 0 0;
}

/* ── Messages ───────────────────────────────────────────────────────────── */

/* No bubbles and no borders: a message is a block of text marked by its
   prefix.  The rhythm is that a user message has a blank row above it and an
   assistant message has one below, so turns separate without a drawn rule. */

.user-message {
    margin: 1 0 0 0;
    padding: 0 1;
    height: auto;
}

.assistant-message {
    margin: 0 0 1 0;
    padding: 0 1;
    height: auto;
}

.system-message {
    margin: 0;
    padding: 0 1;
    height: auto;
    text-style: italic;
}

/* ── Tool calls ─────────────────────────────────────────────────────────── */

/* Collapsed this is one row; expanded it is a panel.  The 60% cap plus the
   internal scroll means a large result stays readable in place instead of
   pushing the conversation off the screen — and the line cap in the widget
   bounds the pathological case before layout ever sees it. */
.tool-call {
    margin: 0 1 1 1;
    padding: 0 1;
    border: solid $slife-border;
    background: $slife-panel;
    width: 1fr;
    height: auto;
    max-height: 60%;
    min-height: 1;
    overflow-y: auto;
    overflow-x: hidden;
    scrollbar-size: 1 2;
    scrollbar-color: $slife-border-dim;
    scrollbar-background: $slife-panel;
}

.tool-call:focus {
    border: solid $slife-amber;
}

.tool-call > .tool-content {
    width: 100%;
}

/* ── The model picker ───────────────────────────────────────────────────── */

/* The one widget in the transcript that is asking something, and the only one
   with a drawn edge — which is how it reads as a question rather than as part
   of the conversation.  It sits in the stream rather than floating over it, and
   that is v1's arrangement: an answer that was streaming stays above it, and
   what the switch says appears under it, in the order things happened. */
.model-picker {
    margin: 0 1 1 1;
    padding: 0 1;
    border: solid $slife-border;
    background: $slife-panel;
    height: auto;
    width: 1fr;
}

/* Lit while it has the keys, which is while it is undecided: the picker hands
   the focus back as it resolves, so the edge dimming is the same fact as the
   keys belonging to the prompt again. */
.model-picker:focus {
    border: solid $slife-amber;
}

/* The subagent picker wears the model picker's clothes: both are questions in
   the stream, and the drawn edge is what says so.  Same rules, a second class
   because the two rows say different things and a later change to one should
   not silently change the other. */
.conversation-picker {
    margin: 0 1 1 1;
    padding: 0 1;
    border: solid $slife-border;
    background: $slife-panel;
    height: auto;
    width: 1fr;
}

.conversation-picker:focus {
    border: solid $slife-amber;
}

/* ── The watch screen ───────────────────────────────────────────────────── */

/* A read-only view over the whole window, with the conversation filling it.
   The header is the one line that is not the conversation: it names whose it
   is and the key that leaves. */
WatchScreen {
    layout: vertical;
    background: $slife-bg;
}

#watch-header {
    height: 1;
    padding: 0 1;
    background: $slife-panel;
    color: $slife-dim;
}

/* ── The approval row ───────────────────────────────────────────────────── */

/* The second thing in the transcript that asks something, and it wears the
   picker's clothes for the picker's reason: a drawn edge is how a question
   reads as a question rather than as part of the conversation.  It is the more
   consequential of the two — the loop is parked on the answer — so it is not
   the row to leave looking like a message, which is what it did while the class
   `add_approval` gives it was styled by nothing at all. */
.approval-prompt {
    margin: 0 1 1 1;
    padding: 0 1;
    border: solid $slife-border;
    background: $slife-panel;
    height: auto;
    width: 1fr;
}

/* Lit while it has the keys.  Undecided and unfocused is the ordinary state
   after a keystroke has gone to the prompt (`redirect_printable`), and the row
   staying up past that blur is the point — so the dim edge is "answer me, but
   the keyboard is elsewhere" rather than "finished" (`ApprovalPrompt`). */
.approval-prompt:focus {
    border: solid $slife-amber;
}

/* ── The prompt ─────────────────────────────────────────────────────────── */

/* Three rows to start, twelve at most, growing upward with the draft.  The
   rule above it is the only line on the screen, and it fades out on focus so
   that typing has nothing competing with it. */
#user-input {
    height: auto;
    min-height: 3;
    max-height: 12;
    padding: 0 1;
    background: $slife-bg;
    color: $slife-text;
    border: none;
    border-top: solid $slife-border;
    scrollbar-size: 0 0;
}

#user-input:focus {
    border-top: solid $slife-bg;
}

#user-input > .text-area--placeholder {
    color: $slife-border-dim;
}

/* ── The status row ─────────────────────────────────────────────────────── */

StatusBar {
    height: 1;
    padding: 0 1;
    background: $slife-panel;
    color: $slife-dim;
}

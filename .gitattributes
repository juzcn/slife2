# The installer is run by both a POSIX shell and Windows PowerShell.  A CRLF
# script fails on Unix, and a TAB-separated table read as CRLF makes the last
# column carry a `\r` on every platform but Windows.
scripts/*.sh text eol=lf
scripts/*.py text eol=lf
scripts/*.ps1 text eol=crlf
scripts/*.cmd text eol=crlf

# tiktoken's vocabulary is bytes, and tiktoken verifies its hash.  An EOL
# conversion on checkout would change the file and make `get_encoding` fetch
# instead of reading it; the data is not a diff anyone reads.
slife2/libs/turn/tiktoken_cache/fb374d419588a4632f3f557e76b4b70aebbca790 binary

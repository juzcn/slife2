# The installer is run by both a POSIX shell and Windows PowerShell.  A CRLF
# script fails on Unix, and a TAB-separated table read as CRLF makes the last
# column carry a `\r` on every platform but Windows.
scripts/*.sh text eol=lf
scripts/*.py text eol=lf
scripts/*.tsv text eol=lf
scripts/*.ps1 text eol=crlf
scripts/*.cmd text eol=crlf
